# Code4Each Upwork agent (Mac mini). Copy to agent.env (never commit it).
# Business configuration (profiles, scoring, schedule, enable/disable) lives in the PMS.

PMS_URL=https://pms.example.com
# Prefer the macOS Keychain over a plain value:
#   security add-generic-password -s code4each-upwork-agent -a pms -w '<token>'
PMS_TOKEN_COMMAND=security find-generic-password -s code4each-upwork-agent -a pms -w
# PMS_TOKEN=

# Upwork agency org_uid (from list_accounts)
ORG_UID=

CLAUDE_BIN=/Users/YOUR_USER/.local/bin/claude
CLAUDE_MODEL=
CLAUDE_MAX_BUDGET_USD=0.50
CLAUDE_TIMEOUT_SECONDS=600
CLAUDE_WORKDIR=/tmp/code4each-upwork-agent-work

AGENT_HOST=code4each-mac-mini
LOG_DIR=/Users/YOUR_USER/Library/Logs/code4each-upwork-agent
LOCK_FILE=/tmp/code4each-upwork-agent.lock
ENRICH_BATCH_SIZE=5
